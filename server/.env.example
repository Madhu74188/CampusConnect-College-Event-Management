# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Local MongoDB)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/collegeEvents?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a long random secure string)
JWT_SECRET=your_jwt_secret_key_change_in_production_2026

# Seed Admin & Coordinator Default Credentials
DEFAULT_ADMIN_EMAIL=admin@college.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_COORD_EMAIL=coordinator@college.com
DEFAULT_COORD_PASSWORD=Coordinator@123

# Email Service Configuration (Nodemailer SMTP)
# For Gmail: Use a 16-character Google App Password (not your normal password)
# If left empty, CampusConnect logs email registration receipts to server console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="CampusConnect Events" <noreply@campusconnect.edu>

# Frontend Client URL (For CORS whitelist in production)
CLIENT_URL=https://madhu74188.github.io
