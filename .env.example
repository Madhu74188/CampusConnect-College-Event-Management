# ========================================================
# CampusConnect Environment Configuration Guide
# ========================================================
# Copy these templates to your respective server/ and client/ environments.
# NEVER commit your actual .env files to Git.

# --- Backend Configuration (server/.env) ---
# PORT=5000
# NODE_ENV=production
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/collegeEvents?retryWrites=true&w=majority
# JWT_SECRET=your_jwt_secret_key_change_in_production_2026
# DEFAULT_ADMIN_EMAIL=admin@college.com
# DEFAULT_ADMIN_PASSWORD=Admin@123
# DEFAULT_COORD_EMAIL=coordinator@college.com
# DEFAULT_COORD_PASSWORD=Coordinator@123
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_gmail_app_password
# CLIENT_URL=https://madhu74188.github.io

# --- Frontend Configuration (client/.env) ---
# VITE_API_URL=http://localhost:5000/api
